<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/meaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textIsSelectable="true" />
        <TextView android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:textIsSelectable="true" />
        <TextView android:id="@+id/provenance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary" />
        <Button android:id="@+id/sources" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/view_sources" />
        <Button android:id="@+id/favourite" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save_favourite" />
        <Button android:id="@+id/remove" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remove_term" />
        <Button android:id="@+id/reset" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/discard_edit" />
    </LinearLayout>
</ScrollView>
