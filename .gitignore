# Local Gradle and Android Studio state
.gradle/
**/build/
local.properties
.idea/
*.iml
.DS_Store
.kotlin/

# Python cache and local environment
__pycache__/
*.pyc
.venv/

# Signing keys and local credentials
*.keystore
*.jks
keystore.properties
.env
.env.*

# Generated packages, databases, logs, and archives
# Android Studio signed APK output (distinct from app/src flavour sources).
/app/private/
/app/public/
*.apk
*.aab
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
*.zip

# Private reference material rejected by tools/check_public.py
*.pdf
*.xlsx
provenance/
downloads/

# Only the root private folder; app/src/private contains required flavour code.
/private/
